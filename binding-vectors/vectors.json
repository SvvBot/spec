{
  "spec": "NOMOS-SPEC-011",
  "version": "0.1.0",
  "parse": [
    {
      "name": "minimal",
      "why": "the smallest valid file",
      "json": "{\"version\":1,\"artifact\":\"art_x\",\"reviewed\":false,\"tools\":{}}",
      "valid": true,
      "normal": {
        "version": 1,
        "artifact": "art_x",
        "reviewed": false,
        "tools": {}
      },
      "digest": "9939c5d1ecb8920f2935518bd3e073c4c1a5b7de72bf2ebeac747f8e0a85f2f4"
    },
    {
      "name": "full",
      "why": "scale, map, nested argument, comments dropped from the normal form",
      "json": "{\"version\":1,\"artifact\":\"art_refunds\",\"reviewed\":true,\"_review\":\"checked by ops, 2026-11-07\",\"tools\":{\"mcp__payments__issue_refund\":{\"_why\":\"the payments server\",\"facts\":{\"refund_amount\":{\"arg\":\"amount_cents\",\"scale\":0.01,\"_why\":\"cents to dollars\"},\"kyc_status\":{\"arg\":\"customer.kyc\",\"map\":{\"ok\":\"verified\",\"bad\":\"failed\"}},\"days\":{\"arg\":\"days_since_purchase\"}}}}}",
      "valid": true,
      "normal": {
        "version": 1,
        "artifact": "art_refunds",
        "reviewed": true,
        "tools": {
          "mcp__payments__issue_refund": {
            "facts": {
              "refund_amount": {
                "arg": "amount_cents",
                "scale": 0.01
              },
              "kyc_status": {
                "arg": "customer.kyc",
                "map": {
                  "ok": "verified",
                  "bad": "failed"
                }
              },
              "days": {
                "arg": "days_since_purchase"
              }
            }
          }
        }
      },
      "digest": "9ef5deb128ae5195378d735a3a73e2de5042263d5034b8f44f0f4f42507546c0"
    },
    {
      "name": "map_of_mixed_values",
      "why": "a map may translate to strings, numbers and booleans",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"map\":{\"1\":true,\"yes\":1,\"no\":\"denied\"}}}}}}",
      "valid": true,
      "normal": {
        "version": 1,
        "artifact": "a",
        "reviewed": true,
        "tools": {
          "t": {
            "facts": {
              "f": {
                "arg": "x",
                "map": {
                  "1": true,
                  "yes": 1,
                  "no": "denied"
                }
              }
            }
          }
        }
      },
      "digest": "914e45c6da4b7e1a0014e61053a2b6557816a307fb4b05a9d67c73334c592b64"
    },
    {
      "name": "not_an_object",
      "why": "a file must be an object",
      "json": "[]",
      "valid": false
    },
    {
      "name": "version_2",
      "why": "only version 1 exists",
      "json": "{\"version\":2,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{}}",
      "valid": false
    },
    {
      "name": "version_string",
      "why": "version is the number 1",
      "json": "{\"version\":\"1\",\"artifact\":\"a\",\"reviewed\":true,\"tools\":{}}",
      "valid": false
    },
    {
      "name": "artifact_empty",
      "why": "the file names the policy it belongs to",
      "json": "{\"version\":1,\"artifact\":\"\",\"reviewed\":true,\"tools\":{}}",
      "valid": false
    },
    {
      "name": "reviewed_missing",
      "why": "reviewed is required",
      "json": "{\"version\":1,\"artifact\":\"a\",\"tools\":{}}",
      "valid": false
    },
    {
      "name": "reviewed_string",
      "why": "reviewed is a boolean",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":\"yes\",\"tools\":{}}",
      "valid": false
    },
    {
      "name": "tools_array",
      "why": "tools is an object",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":[]}",
      "valid": false
    },
    {
      "name": "unknown_top_level",
      "why": "an unknown setting is refused, not ignored",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{},\"defaults\":{\"kyc_status\":\"verified\"}}",
      "valid": false
    },
    {
      "name": "tool_proto",
      "why": "a reserved name is refused",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"__proto__\":{\"facts\":{}}}}",
      "valid": false
    },
    {
      "name": "tool_not_object",
      "why": "a tool entry is an object",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":\"x\"}}",
      "valid": false
    },
    {
      "name": "tool_unknown_key",
      "why": "a tool entry holds facts and nothing else",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{},\"always\":\"allow\"}}}",
      "valid": false
    },
    {
      "name": "tool_without_facts",
      "why": "facts is required",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{}}}",
      "valid": false
    },
    {
      "name": "fact_named_tool",
      "why": "\"tool\" is set by the enforcement point",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"tool\":{\"arg\":\"x\"}}}}}",
      "valid": false
    },
    {
      "name": "fact_constructor",
      "why": "a reserved name is refused",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"constructor\":{\"arg\":\"x\"}}}}}",
      "valid": false
    },
    {
      "name": "binding_not_object",
      "why": "a fact binding is an object",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":\"x\"}}}}",
      "valid": false
    },
    {
      "name": "constant",
      "why": "a fact only ever comes from an argument: no constants",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"value\":\"verified\"}}}}}",
      "valid": false
    },
    {
      "name": "constant_alongside_arg",
      "why": "nor alongside an argument",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"default\":\"verified\"}}}}}",
      "valid": false
    },
    {
      "name": "arg_missing",
      "why": "arg is required",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{}}}}}",
      "valid": false
    },
    {
      "name": "arg_empty",
      "why": "arg is a non-empty path",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"\"}}}}}",
      "valid": false
    },
    {
      "name": "arg_empty_segment",
      "why": "every segment is non-empty",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"a..b\"}}}}}",
      "valid": false
    },
    {
      "name": "arg_proto_segment",
      "why": "a reserved segment is refused",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"a.__proto__\"}}}}}",
      "valid": false
    },
    {
      "name": "scale_and_map",
      "why": "scale or map, not both",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"scale\":2,\"map\":{\"a\":\"b\"}}}}}}",
      "valid": false
    },
    {
      "name": "scale_zero",
      "why": "scale is a non-zero number",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"scale\":0}}}}}",
      "valid": false
    },
    {
      "name": "scale_string",
      "why": "scale is a number",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"scale\":\"0.01\"}}}}}",
      "valid": false
    },
    {
      "name": "map_array",
      "why": "map is an object",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"map\":[\"a\"]}}}}}",
      "valid": false
    },
    {
      "name": "map_object_value",
      "why": "map holds plain values only",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"map\":{\"a\":{\"b\":1}}}}}}}",
      "valid": false
    },
    {
      "name": "map_null_value",
      "why": "null is not a plain value here",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"map\":{\"a\":null}}}}}}",
      "valid": false
    },
    {
      "name": "map_proto_key",
      "why": "a reserved key is refused",
      "json": "{\"version\":1,\"artifact\":\"a\",\"reviewed\":true,\"tools\":{\"t\":{\"facts\":{\"f\":{\"arg\":\"x\",\"map\":{\"__proto__\":\"y\"}}}}}}",
      "valid": false
    }
  ],
  "apply": [
    {
      "name": "copy_values",
      "why": "a number, a string and a boolean pass through",
      "bindings": {
        "version": 1,
        "artifact": "art_v",
        "reviewed": true,
        "tools": {
          "t": {
            "facts": {
              "amount": {
                "arg": "amount"
              },
              "region": {
                "arg": "region"
              },
              "defective": {
                "arg": "defective"
              }
            }
          }
        }
      },
      "tool": "t",
      "args": {
        "amount": 50,
        "region": "EU",
        "defective": true
      },
      "inputs": {
        "tool": "t",
        "amount": 50,
        "region": "EU",
        "defective": true
      },
      "unresolved": []
    },
